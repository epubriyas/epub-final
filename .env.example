DATABASE_URL=postgresql://epubtrans:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/epubtrans
PAYLOAD_SECRET=GENERATE_A_STRONG_RANDOM_SECRET
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# On Vercel, set NEXT_PUBLIC_SERVER_URL to the public HTTPS domain (no localhost).
# Connect the persistent Blob store for production uploads. Never commit its token.
BLOB_READ_WRITE_TOKEN=
PREVIEW_SECRET=GENERATE_A_DISTINCT_RANDOM_SECRET
PRIVATE_UPLOAD_DIR=private-uploads
# Manager receives notifications; the sender must use a Resend-verified domain.
MANAGER_EMAIL=
ENQUIRY_RECIPIENT_APPROVED=false
EPUBTRANS_INDEXING_APPROVED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=EPUBTRANS <info@epubtrans.com>
QUOTE_EMAIL_FROM=EPUBTRANS <info@epubtrans.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TRUST_NGINX_PROXY=false
# Optional: Google Cloud Translation Basic API key, kept server-side. MyMemory is used without a key.
GOOGLE_TRANSLATE_API_KEY=
GEMINI_API_KEY=
GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite
ASSISTANT_DAILY_REQUEST_LIMIT=300
TRANSLATION_DAILY_CHARACTER_LIMIT=250000
