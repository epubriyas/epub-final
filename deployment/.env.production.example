NEXT_PUBLIC_SERVER_URL=https://your-domain.example
SITE_HOST=your-domain.example
POSTGRES_DB=epubtrans
POSTGRES_USER=epubtrans
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
PAYLOAD_SECRET=replace-with-a-different-openssl-rand-hex-32
PREVIEW_SECRET=replace-with-another-openssl-rand-hex-32
CERTIFICATE_DIRECTORY=/etc/letsencrypt
MANAGER_EMAIL=riyastech001@gmail.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=EPUBTRANS <info@epubtrans.com>
# Optional Cloud Translation key for higher traffic. Without it, the app uses MyMemory's quota-limited public API.
GOOGLE_TRANSLATE_API_KEY=
GEMINI_API_KEY=
GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite
ASSISTANT_DAILY_REQUEST_LIMIT=300
TRANSLATION_DAILY_CHARACTER_LIMIT=250000
